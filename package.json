{
  "name": "mom-action-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:e2e": "playwright test",
    "lint:api": "redocly lint specs/001-meeting-action-tracker/contracts/openapi.yaml --format=summary",
    "lint:licenses": "license-checker --excludePrivatePackages --summary --onlyAllow \"MIT;MIT-0;MIT*;Apache-2.0;BSD-2-Clause;BSD-3-Clause;BSD*;ISC;MPL-2.0;0BSD;BlueOak-1.0.0;CC0-1.0;CC-BY-3.0;CC-BY-4.0;Python-2.0;(MPL-2.0 OR Apache-2.0);(MIT AND CC-BY-3.0)\"",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run lint:api && npm run lint:licenses",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend --"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.52.0",
    "@redocly/cli": "^1.34.0",
    "@types/node": "^22.15.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.28.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "license-checker": "^25.0.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
